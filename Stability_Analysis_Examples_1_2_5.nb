Cell[TextData[{
 "The equation is singular in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["v", "TI"], "\[LongEqual]", "0"}], TraditionalForm]],
  ExpressionUUID->"51083853-3a08-bc48-8268-0c65f7874684"],
 ". The problem splits in two identical subproblems, negative ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["v", "TI"], "\[Element]", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "0"}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"f8de1ffe-8a00-9c41-b042-0715351bf1ee"],
 " and positive ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["v", "TI"], "\[Element]", 
    RowBox[{"[", 
     RowBox[{"0", ",", "1"}], "]"}]}], TraditionalForm]],ExpressionUUID->
  "fd79c5ac-ba4d-414c-8778-9ccc26f255e0"],
 ". Let us consider the negative subproblem."
}], "Text",
 CellChangeTimes->{{3.9864343496162605`*^9, 
  3.986434455556322*^9}},ExpressionUUID->"c1489b69-ea85-8c41-a61f-\
dcdfb05ccbdd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"c1", "=", 
   RowBox[{"Coefficient", "[", 
    RowBox[{"eqz\[Eta]", ",", 
     RowBox[{
      RowBox[{"z\[Eta]", "'"}], "[", "v", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c0", "=", 
   RowBox[{"Coefficient", "[", 
    RowBox[{"eqz\[Eta]", ",", 
     RowBox[{"z\[Eta]", "[", "v", "]"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"166df488-5963-fc4d-b6d6-4dc5d56f1c59"],

