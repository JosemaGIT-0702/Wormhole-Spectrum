      RowBox[{"(", 
       RowBox[{"2", "+", "\[Lambda]", "-", 
        RowBox[{
         SqrtBox["\[Lambda]"], " ", 
         SqrtBox[
          RowBox[{"4", "+", "\[Lambda]"}]]}]}], ")"}], 
      RowBox[{"3", "/", "2"}]], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", "+", "\[Lambda]", "+", 
        RowBox[{
         SqrtBox["\[Lambda]"], " ", 
         SqrtBox[
          RowBox[{"4", "+", "\[Lambda]"}]]}]}], ")"}], 
      RowBox[{"3", "/", "2"}]], " ", 
     RowBox[{"Abs", "[", "\[Lambda]", "]"}]}]], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "v", "]"}], "3"],
    SeriesData[$CellContext`v, 0, {}, -1, 3, 1],
    Editable->False]}],
  SeriesData[$CellContext`v, 0, {
