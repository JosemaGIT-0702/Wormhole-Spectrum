Cell[CellGroupData[{

Cell["Background", "Section",
 CellChangeTimes->{{3.9864319230689907`*^9, 
  3.9864319250326176`*^9}},ExpressionUUID->"62616ec9-8ae1-6449-8ac4-\
1ca24ef9a705"],

Cell["Superpotential:", "Text",
 CellChangeTimes->{{3.986432013444723*^9, 
  3.9864320173447647`*^9}},ExpressionUUID->"e54e7fc4-7394-f048-abfc-\
16cab30ec290"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"W", "[", 
    RowBox[{"\[Chi]_", ",", "\[Alpha]_"}], "]"}], "=", 
   RowBox[{
    FractionBox["3", "L"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Cos", "[", 
       FractionBox["\[Chi]", 
        SqrtBox["3"]], "]"}], "+", 
      RowBox[{"Cos", "[", "\[Alpha]", "]"}]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9864319708742886`*^9, 3.9864320021709785`*^9}, {
  3.986432180100132*^9, 3.9864321843470078`*^9}, {3.98643221711187*^9, 
  3.9864322178034477`*^9}, {3.986461175938839*^9, 3.9864611998317127`*^9}, {
  3.986461309377495*^9, 3.9864613142404118`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"a58b31af-f34f-6b4f-a397-4aa06862d595"],

Cell["Potential from superpotential:", "Text",
 CellChangeTimes->{{3.98643202419207*^9, 
  3.986432038564848*^9}},ExpressionUUID->"5bbe9f5c-2a32-4a41-8012-\
c9bb89dba78e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"d", "=", "4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"V", "[", 
   RowBox[{"\[Chi]_", ",", "\[Alpha]_"}], "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"D", "[", " ", 
         RowBox[{
          RowBox[{"W", "[", 
           RowBox[{"\[Chi]", ",", "\[Alpha]"}], "]"}], ",", "\[Chi]"}], "]"}],
         "2"], "+", 
       SuperscriptBox[
        RowBox[{"D", "[", " ", 
         RowBox[{
          RowBox[{"W", "[", 
           RowBox[{"\[Chi]", ",", "\[Alpha]"}], "]"}], ",", "\[Alpha]"}], 
         "]"}], "2"]}], ")"}]}], "-", 
    RowBox[{
     FractionBox["d", 
      RowBox[{"4", 
       RowBox[{"(", 
        RowBox[{"d", "-", "1"}], ")"}]}]], 
     SuperscriptBox[
      RowBox[{"W", "[", 
       RowBox[{"\[Chi]", ",", "\[Alpha]"}], "]"}], "2"]}]}], "//", 
   "FullSimplify"}]}]}], "Input",
 CellChangeTimes->{{3.9864320582730007`*^9, 3.986432189563511*^9}, {
  3.986432228879017*^9, 3.9864322311144905`*^9}, {3.9864612606420555`*^9, 
  3.986461325384676*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"194bcaac-c5dd-924c-8539-b40aee0003b3"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"3", " ", 
    RowBox[{"(", 
     RowBox[{"8", "-", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "\[Alpha]"}], "]"}], "+", 
      RowBox[{"8", " ", 
       RowBox[{"Cos", "[", "\[Alpha]", "]"}], " ", 
       RowBox[{"Cos", "[", 
        FractionBox["\[Chi]", 
         SqrtBox["3"]], "]"}]}], "+", 
      RowBox[{"Cos", "[", 
       FractionBox[
        RowBox[{"2", " ", "\[Chi]"}], 
        SqrtBox["3"]], "]"}]}], ")"}]}], 
   RowBox[{"4", " ", 
    SuperscriptBox["L", "2"]}]]}]], "Output",
 CellChangeTimes->{
  3.9864321898899517`*^9, {3.9864322203271046`*^9, 3.986432231910454*^9}, 
   3.986432743194227*^9, 3.986433202297367*^9, 3.9864361309667416`*^9, 
   3.9864577879332676`*^9, 3.986458730107689*^9, {3.9864613046220512`*^9, 
   3.986461326123661*^9}, 3.9864618252032776`*^9, 3.9864622983428135`*^9, 
   3.9864626136622124`*^9, 3.9864627660667686`*^9, 3.9865323037722282`*^9, 
   3.9865326472681913`*^9, 3.9865492350291443`*^9, 3.9865523222793045`*^9, 
   3.986572650628193*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"dd075a1e-bed2-9b40-8e1a-e7e540abc628"]
}, Open  ]],

Cell["Background profile of the scalar ghosts:", "Text",
 CellChangeTimes->{{3.986432482130953*^9, 3.9864324921010265`*^9}, {
  3.9864613517136974`*^9, 
  3.98646135469853*^9}},ExpressionUUID->"60068891-dcef-8b41-9e03-\
337a5209cc7e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Chi]0", "[", "r_", "]"}], "=", 
   RowBox[{"2", 
    SqrtBox["3"], 
    RowBox[{"ArcTan", "[", 
     SuperscriptBox["\[ExponentialE]", 
      FractionBox[
       RowBox[{"r", "-", "r1"}], "L"]], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Alpha]0", "[", "r_", "]"}], "=", 
   RowBox[{"2", 
    RowBox[{"ArcTan", "[", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"3", 
       FractionBox[
        RowBox[{"r", "-", "r2"}], "L"]}]], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.986432497798546*^9, 3.9864325351459637`*^9}, {
  3.986461390823057*^9, 3.9864614132758636`*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"2bfca353-2162-f243-bd26-483298aad166"],

Cell[TextData[{
 "For convenience, we define the warp factor as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["a", "TI"], "(", 
     StyleBox["r", "TI"], ")"}], "\[Congruent]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"2", 
      RowBox[{
       StyleBox["A", "TI"], "(", 
       StyleBox["r", "TI"], ")"}]}]]}], TraditionalForm]],ExpressionUUID->
  "40c7a688-89e3-ee47-bf27-f799846e7f36"],
 ", with"
}], "Text",
 CellChangeTimes->{{3.98643262805085*^9, 
  3.986432672654991*^9}},ExpressionUUID->"264d90f6-946c-974d-bd41-\
dbbce1d76317"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"a", "[", "r_", "]"}], "=", 
   RowBox[{
    SuperscriptBox["2", 
     RowBox[{"4", "/", "3"}]], " ", 
    RowBox[{"Cosh", "[", 
     FractionBox[
      RowBox[{" ", 
       RowBox[{"r", "-", "r1"}]}], 
      RowBox[{" ", "L"}]], "]"}], 
    SuperscriptBox[
     RowBox[{"Cosh", "[", 
      RowBox[{"3", " ", 
       FractionBox[
        RowBox[{"r", "-", "r2"}], "L"]}], "]"}], 
     RowBox[{"1", "/", "3"}]]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9864327029873905`*^9, 3.9864327181916695`*^9}, {
  3.986433197160818*^9, 3.9864331972702103`*^9}, {3.986461450965124*^9, 
  3.986461483333603*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"83592373-128c-8949-bf31-dbf2abf25d2d"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["Z", "\[Chi]"], TraditionalForm]],ExpressionUUID->
  "9a500166-fc3c-5b46-9363-1c6853262866"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Z", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "41c4bbb3-48d8-f848-b324-6d13198f6efd"],
 " fluctuation equations"
}], "Section",
 CellChangeTimes->{{3.986461524945507*^9, 3.9864615288787975`*^9}, {
  3.9864625917846146`*^9, 
  3.986462633513565*^9}},ExpressionUUID->"3c618cbc-de08-cc42-ad71-\
f233d4c6fe5a"],

Cell[TextData[{
 "We have already set the scalar, gauge-invariant combination of the metric \
to zero, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["S", "TI"]], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "cf9e4920-5e4f-be49-8386-5b7a0d73e114"],
 ". We define the dimensionless eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "\[Congruent]", 
    RowBox[{"L", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["\[Omega]", "2"], "-", 
       SuperscriptBox[
        StyleBox["k", "TI"], "2"]}]]}]}], TraditionalForm]],ExpressionUUID->
  "0c721d54-fa09-b84c-925d-14566cd1adb0"],
 "."
}], "Text",
 CellChangeTimes->{{3.9864615359338455`*^9, 3.986461577991436*^9}, {
  3.9864620284756413`*^9, 
  3.98646203181394*^9}},ExpressionUUID->"f8f0b76d-0153-fb42-a98c-\
1a8e2a9dddf9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"eqZ\[Chi]", "=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{"2", " ", 
            RowBox[{
             SuperscriptBox["a", "\[Prime]",
              MultilineFunction->None], "[", "r", "]"}], " ", 
            RowBox[{
             SuperscriptBox["Z\[Chi]", "\[Prime]",
              MultilineFunction->None], "[", "r", "]"}]}], 
           RowBox[{"a", "[", "r", "]"}]], "+", 
          RowBox[{
           SuperscriptBox["Z\[Chi]", "\[Prime]\[Prime]",
            MultilineFunction->None], "[", "r", "]"}], "+", 
          RowBox[{
           RowBox[{"Z\[Alpha]", "[", "r", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              FractionBox[
               RowBox[{
                RowBox[{"2", " ", 
                 RowBox[{
                  SuperscriptBox["\[Chi]0", "\[Prime]",
                   MultilineFunction->None], "[", "r", "]"}], " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    SuperscriptBox["\[Alpha]0", "\[Prime]",
                    MultilineFunction->None], "[", "r", "]"}], " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"6", " ", 
                    SuperscriptBox[
                    RowBox[{
                    SuperscriptBox["a", "\[Prime]",
                    MultilineFunction->None], "[", "r", "]"}], "2"]}], "+", 
                    RowBox[{
                    SuperscriptBox[
                    RowBox[{"a", "[", "r", "]"}], "2"], " ", 
                    RowBox[{"(", 
                    RowBox[{
                    SuperscriptBox[
                    RowBox[{
                    SuperscriptBox["\[Alpha]0", "\[Prime]",
                    MultilineFunction->None], "[", "r", "]"}], "2"], "+", 
                    SuperscriptBox[
                    RowBox[{
                    SuperscriptBox["\[Chi]0", "\[Prime]",
                    MultilineFunction->None], "[", "r", "]"}], "2"]}], 
                    ")"}]}]}], ")"}]}], "+", 
                   RowBox[{"3", " ", 
                    RowBox[{"a", "[", "r", "]"}], " ", 
                    RowBox[{
                    SuperscriptBox["a", "\[Prime]",
                    MultilineFunction->None], "[", "r", "]"}], " ", 
                    RowBox[{
                    SuperscriptBox["V", 
                    TagBox[
                    RowBox[{"(", 
                    RowBox[{"0", ",", "1"}], ")"}],
                    Derivative],
                    MultilineFunction->None], "[", 
                    RowBox[{
                    RowBox[{"\[Chi]0", "[", "r", "]"}], ",", 
                    RowBox[{"\[Alpha]0", "[", "r", "]"}]}], "]"}]}]}], 
                  ")"}]}], "+", 
                RowBox[{"6", " ", 
                 RowBox[{"a", "[", "r", "]"}], " ", 
                 RowBox[{
                  SuperscriptBox["a", "\[Prime]",
                   MultilineFunction->None], "[", "r", "]"}], " ", 
                 RowBox[{
                  SuperscriptBox["\[Alpha]0", "\[Prime]",
                   MultilineFunction->None], "[", "r", "]"}], " ", 
                 RowBox[{
                  SuperscriptBox["V", 
                   TagBox[
                    RowBox[{"(", 
                    RowBox[{"1", ",", "0"}], ")"}],
                    Derivative],
                   MultilineFunction->None], "[", 
                  RowBox[{
                   RowBox[{"\[Chi]0", "[", "r", "]"}], ",", 
                   RowBox[{"\[Alpha]0", "[", "r", "]"}]}], "]"}]}]}], 
               RowBox[{"9", " ", 
                SuperscriptBox[
                 RowBox[{
                  SuperscriptBox["a", "\[Prime]",
                   MultilineFunction->None], "[", "r", "]"}], "2"]}]]}], "+", 
             RowBox[{
              SuperscriptBox["V", 
               TagBox[
                RowBox[{"(", 
                 RowBox[{"1", ",", "1"}], ")"}],
                Derivative],
               MultilineFunction->None], "[", 
              RowBox[{
               RowBox[{"\[Chi]0", "[", "r", "]"}], ",", 
               RowBox[{"\[Alpha]0", "[", "r", "]"}]}], "]"}]}], ")"}]}], "+", 
          RowBox[{
           RowBox[{"Z\[Chi]", "[", "r", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{
             FractionBox[
              RowBox[{
               RowBox[{"-", 
                SuperscriptBox["k", "2"]}], "+", 
               SuperscriptBox["w", "2"]}], 
              RowBox[{"a", "[", "r", "]"}]], "-", 
             RowBox[{
              FractionBox["4", "3"], " ", 
              SuperscriptBox[
               RowBox[{
                SuperscriptBox["\[Chi]0", "\[Prime]",
                 MultilineFunction->None], "[", "r", "]"}], "2"]}], "-", 
             FractionBox[
              RowBox[{"2", " ", 
               SuperscriptBox[
                RowBox[{"a", "[", "r", "]"}], "2"], " ", 
               SuperscriptBox[
                RowBox[{
                 SuperscriptBox["\[Chi]0", "\[Prime]",
                  MultilineFunction->None], "[", "r", "]"}], "2"], " ", 
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox[
                  RowBox[{
                   SuperscriptBox["\[Alpha]0", "\[Prime]",
                    MultilineFunction->None], "[", "r", "]"}], "2"], "+", 
                 SuperscriptBox[
                  RowBox[{
                   SuperscriptBox["\[Chi]0", "\[Prime]",
                    MultilineFunction->None], "[", "r", "]"}], "2"]}], 
                ")"}]}], 
              RowBox[{"9", " ", 
               SuperscriptBox[
                RowBox[{
                 SuperscriptBox["a", "\[Prime]",
                  MultilineFunction->None], "[", "r", "]"}], "2"]}]], "-", 
             FractionBox[
              RowBox[{"4", " ", 
               RowBox[{"a", "[", "r", "]"}], " ", 
               RowBox[{
                SuperscriptBox["\[Chi]0", "\[Prime]",
                 MultilineFunction->None], "[", "r", "]"}], " ", 
               RowBox[{
                SuperscriptBox["V", 
                 TagBox[
                  RowBox[{"(", 
                   RowBox[{"1", ",", "0"}], ")"}],
                  Derivative],
                 MultilineFunction->None], "[", 
                RowBox[{
                 RowBox[{"\[Chi]0", "[", "r", "]"}], ",", 
                 RowBox[{"\[Alpha]0", "[", "r", "]"}]}], "]"}]}], 
              RowBox[{"3", " ", 
               RowBox[{
                SuperscriptBox["a", "\[Prime]",
                 MultilineFunction->None], "[", "r", "]"}]}]], "+", 
             RowBox[{
              SuperscriptBox["V", 
               TagBox[
                RowBox[{"(", 
                 RowBox[{"2", ",", "0"}], ")"}],
                Derivative],
               MultilineFunction->None], "[", 
              RowBox[{
               RowBox[{"\[Chi]0", "[", "r", "]"}], ",", 
               RowBox[{"\[Alpha]0", "[", "r", "]"}]}], "]"}]}], ")"}]}]}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"r1", "->", "0"}], ",", 
           RowBox[{"r2", "->", "0"}]}], "}"}]}], "/.", 
        RowBox[{"w", "->", 
         FractionBox[
          SqrtBox[
           RowBox[{"\[Lambda]", "+", 
            RowBox[{
             SuperscriptBox["L", "2"], 
             SuperscriptBox["k", "2"]}]}]], "L"]}]}], "//", "TrigToExp"}], "//",
       "Simplify"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox["Z\[Chi]", "\[Prime]\[Prime]",
         MultilineFunction->None], "[", "r", "]"}], ",", 
       RowBox[{
        SuperscriptBox["Z\[Chi]", "\[Prime]",
         MultilineFunction->None], "[", "r", "]"}], ",", 
