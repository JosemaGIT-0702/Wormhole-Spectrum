Cell[TextData[{
 "We study the leading behavior of the equations at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", "1"}]}], TraditionalForm]],ExpressionUUID->
  "d7043b43-a193-794b-ae1d-32fb88d1cd17"],
 " so to relate the values of the solutions and their derivatives; this is \
needed because the numerical solver we are setting up needs two initial \
conditions for each field."
}], "Text",
 CellChangeTimes->{{3.986572231019598*^9, 3.9865723696177464`*^9}, {
  3.9865724778114624`*^9, 
  3.9865725588642273`*^9}},ExpressionUUID->"abc7619e-8fba-9e45-9d83-\
7f8bbb4c06b5"],

