Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"auxeq", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         SuperscriptBox["z\[Eta]", "\[Prime]\[Prime]",
          MultilineFunction->None], "[", "r", "]"}], "+", 
        RowBox[{
         FractionBox[
          RowBox[{"3", " ", 
           RowBox[{
            SuperscriptBox["a", "\[Prime]",
             MultilineFunction->None], "[", "r", "]"}], " "}], 
          RowBox[{"2", 
           RowBox[{"a", "[", "r", "]"}]}]], 
         RowBox[{
          SuperscriptBox["z\[Eta]", "\[Prime]",
           MultilineFunction->None], "[", "r", "]"}]}], "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           FractionBox[
            RowBox[{
             SuperscriptBox["w", "2"], "-", 
             SuperscriptBox["k", "2"]}], 
            RowBox[{"a", "[", "r", "]"}]], "-", 
           FractionBox[
            RowBox[{"2", " ", 
             RowBox[{"a", "[", "r", "]"}], " ", 
             RowBox[{
              SuperscriptBox["V", "\[Prime]",
               MultilineFunction->None], "[", 
              RowBox[{"\[Eta]0", "[", "r", "]"}], "]"}], " ", 
             RowBox[{
              SuperscriptBox["\[Eta]0", "\[Prime]",
               MultilineFunction->None], "[", "r", "]"}]}], 
            RowBox[{
             SuperscriptBox["a", "\[Prime]",
              MultilineFunction->None], "[", "r", "]"}]], "-", 
           RowBox[{
            FractionBox["3", "2"], " ", 
            SuperscriptBox[
             RowBox[{
              SuperscriptBox["\[Eta]0", "\[Prime]",
               MultilineFunction->None], "[", "r", "]"}], "2"]}], "-", 
           FractionBox[
            RowBox[{
             SuperscriptBox[
              RowBox[{"a", "[", "r", "]"}], "2"], " ", 
             SuperscriptBox[
              RowBox[{
               SuperscriptBox["\[Eta]0", "\[Prime]",
                MultilineFunction->None], "[", "r", "]"}], "4"]}], 
            RowBox[{"2", 
             SuperscriptBox[
              RowBox[{
               SuperscriptBox["a", "\[Prime]",
                MultilineFunction->None], "[", "r", "]"}], "2"]}]], "+", 
           RowBox[{
            SuperscriptBox["V", "\[Prime]\[Prime]",
             MultilineFunction->None], "[", 
            RowBox[{"\[Eta]0", "[", "r", "]"}], "]"}]}], ")"}], 
         RowBox[{"z\[Eta]", "[", "r", "]"}]}]}], "/.", 
       RowBox[{"w", "\[Rule]", "0"}]}], "/.", 
      RowBox[{"k", "\[Rule]", "0"}]}], "/.", 
     RowBox[{"r0", "\[Rule]", "0"}]}], "/.", 
    RowBox[{"L", "\[Rule]", "1"}]}], "//", "FullSimplify"}]}]], "Input",
 CellChangeTimes->{{4.0040002271205273`*^9, 4.0040002433576937`*^9}, {
  4.004001693656472*^9, 4.004001718930585*^9}, {4.0040017793735275`*^9, 
  4.004001795438429*^9}, {4.0040022724585037`*^9, 4.0040022860966883`*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"3746d702-d4b5-405c-ba08-5e0f1329706d"],

