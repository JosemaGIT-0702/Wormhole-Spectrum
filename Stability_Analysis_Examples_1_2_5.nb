Cell[CellGroupData[{

Cell["Numerics (Chebyshev spectral method)", "Section",
 CellChangeTimes->{{3.9828334408029146`*^9, 3.9828334441804185`*^9}, {
   3.982837232137474*^9, 3.9828372333491344`*^9}, 3.986434253035969*^9, {
   3.9864581267000675`*^9, 
   3.9864581399313602`*^9}},ExpressionUUID->"3e4bfc73-2d33-c248-a104-\
ca12fd8dc495"],

Cell["We define the coefficients of the discretized matrix. ", "Text",
 CellChangeTimes->{{3.9864357510158024`*^9, 3.986435754880148*^9}, {
   3.986456902791998*^9, 3.9864569929184017`*^9}, 
   3.986457374023134*^9},ExpressionUUID->"b835b25b-6dbb-1749-8c99-\
76665556208a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"A0", ",", "A1", ",", "B0", ",", "B1", ",", "S0"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"S0", "[", "s_", "]"}], "=", 
   RowBox[{"Coefficient", "[", 
    RowBox[{"eq\[Psi]", ",", 
     RowBox[{
      SuperscriptBox["\[Psi]", "\[Prime]\[Prime]",
       MultilineFunction->None], "[", "s", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"A0", "[", "s_", "]"}], "=", 
   RowBox[{
    RowBox[{"Coefficient", "[", 
     RowBox[{"eq\[Psi]", ",", 
      RowBox[{
       SuperscriptBox["\[Psi]", "\[Prime]",
        MultilineFunction->None], "[", "s", "]"}]}], "]"}], "/.", 
    RowBox[{"\[Lambda]", "->", "0"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"A1", "[", "s_", "]"}], "=", 
   RowBox[{"Coefficient", "[", 
    RowBox[{
     RowBox[{"Coefficient", "[", 
      RowBox[{"eq\[Psi]", ",", 
       RowBox[{
        SuperscriptBox["\[Psi]", "\[Prime]",
         MultilineFunction->None], "[", "s", "]"}]}], "]"}], ",", 
     "\[Lambda]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"B0", "[", "s_", "]"}], "=", 
   RowBox[{
    RowBox[{"Coefficient", "[", 
     RowBox[{"eq\[Psi]", ",", 
      RowBox[{"\[Psi]", "[", "s", "]"}]}], "]"}], "/.", 
    RowBox[{"\[Lambda]", "->", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"B1", "[", "s_", "]"}], "=", 
   RowBox[{"Coefficient", "[", 
    RowBox[{
     RowBox[{"Coefficient", "[", 
      RowBox[{"eq\[Psi]", ",", 
       RowBox[{"\[Psi]", "[", "s", "]"}]}], "]"}], ",", "\[Lambda]"}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.986435758991049*^9, 3.986435831883772*^9}, {
  3.9864362398962555`*^9, 3.986436246362587*^9}, {3.9864363188985806`*^9, 
  3.9864363195440006`*^9}, {3.986436499172121*^9, 3.986436555857033*^9}, {
  3.986457003741188*^9, 3.9864570065362167`*^9}, {3.98645737837002*^9, 
  3.9864573795768375`*^9}, {3.98645779825338*^9, 3.9864578032931976`*^9}},
