        SuperscriptBox["Z\[Eta]", "\[Prime]",
         MultilineFunction->None], "[", "r", "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{
           SuperscriptBox["w", "2"], "-", 
           SuperscriptBox["k", "2"]}], 
          RowBox[{"a", "[", "r", "]"}]], "-", 
         FractionBox[
          RowBox[{"4", " ", 
           RowBox[{"a", "[", "r", "]"}], " ", 
           RowBox[{
            SuperscriptBox["V", "\[Prime]",
             MultilineFunction->None], "[", 
            RowBox[{"\[Eta]0", "[", "r", "]"}], "]"}], " ", 
           RowBox[{
            SuperscriptBox["\[Eta]0", "\[Prime]",
             MultilineFunction->None], "[", "r", "]"}]}], 
          RowBox[{"3", " ", 
