Cell[TextData[{
 "The equation is singular in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["v", "TI"], "\[LongEqual]", "0"}], TraditionalForm]],
  ExpressionUUID->"4acc575d-4875-9843-98e3-d843fbf06e2f"],
 ". The problem splits in two identical subproblems, negative ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["v", "TI"], "\[Element]", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "0"}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"83caa124-3b96-1740-9c82-555179bbc9c0"],
 " and positive ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["v", "TI"], "\[Element]", 
    RowBox[{"[", 
     RowBox[{"0", ",", "1"}], "]"}]}], TraditionalForm]],ExpressionUUID->
  "074e2021-6159-5441-b00f-032855fdf21b"],
 ". Let us consider the negative subproblem."
}], "Text",
