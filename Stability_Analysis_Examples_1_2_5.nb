Cell["Matrices for first and second derivative:", "Text",
 CellChangeTimes->{{3.9864574506854877`*^9, 
  3.986457489459242*^9}},ExpressionUUID->"3b7b13d6-e63d-e640-a369-\
b10090c327c4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"chebD", "[", 
   RowBox[{"n_", ",", 
    RowBox[{"prec_", ":", " ", "MachinePrecision"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "c", ",", "D", ",", "X", ",", "C", ",", "dX"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x", "=", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"Pi", " ", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", "n"}], "]"}], "/", "n"}]}], "]"}], ",", 
        "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "2", "}"}], ",", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"1", ",", 
           RowBox[{"n", "-", "1"}]}], "]"}], ",", 
         RowBox[{"{", "2", "}"}]}], "]"}], "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "^", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "n"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Build", " ", "matrices"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"X", "=", 
      RowBox[{"Outer", "[", 
       RowBox[{"Subtract", ",", "x", ",", "x"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"C", "=", 
      RowBox[{"Outer", "[", 
       RowBox[{"Times", ",", "c", ",", 
        RowBox[{"1", "/", "c"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Add", " ", "identity", " ", "to", " ", "avoid", " ", "division", " ", 
       "by", " ", "zero"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dX", "=", 
      RowBox[{"X", "+", 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"n", "+", "1"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"D", "=", 
      RowBox[{"C", "/", "dX"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Fix", " ", "diagonal"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"D", "=", 
      RowBox[{"D", "-", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Total", "[", 
         RowBox[{"D", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "D"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.986457860949415*^9, 3.9864578637508965`*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"e4a41fbf-73e3-1e43-aaf5-a304392d5c4e"],

