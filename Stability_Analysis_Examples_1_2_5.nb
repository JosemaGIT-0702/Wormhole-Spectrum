Cell[CellGroupData[{

Cell[TextData[{
 "d+1=5 Wormholes ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalN]", "\[LongEqual]", 
    SuperscriptBox["1", "*"]}], TraditionalForm]],ExpressionUUID->
  "f74592d2-5f4e-2749-acab-5678fb322fd8"],
 " SYM GPPZ, two scalars (Example 5)"
}], "Subchapter",
 CellChangeTimes->{{3.9833416864867673`*^9, 3.983341690357538*^9}, {
  3.9857665885783463`*^9, 3.985766592501463*^9}, {3.985786819918578*^9, 
  3.9857868245576534`*^9}, {3.986035157563614*^9, 3.986035158781335*^9}, {
  3.986035312015385*^9, 3.9860353169751577`*^9}, {3.9864316806161747`*^9, 
  3.9864316842615967`*^9}, {3.986431834192404*^9, 3.9864318542199287`*^9}, {
  3.9864583733556232`*^9, 3.9864583736419697`*^9}, {3.9865492651441174`*^9, 
  3.9865492658603*^9}, {3.9865514052163258`*^9, 
  3.98655140578236*^9}},ExpressionUUID->"98bb9774-26b2-f14d-8c18-\
14f858b50d7a"],

Cell[TextData[{
 StyleBox["Methodology:",
  FontWeight->"Bold"],
 "\nThis example involves two scalar fields and the coupled ODEs governing \
their fluctuations.\n\nWe first compactify the radial domain introducing a \
coordinate \[Upsilon] \[Element] [-1,1]. The resulting ODE system has a \
singular point at \[Upsilon] = 0, which requires us to split the problem into \
two subdomains, \[Upsilon] \[Element] [-1,0] and \[Upsilon] \[Element] [0,1]. \
Since the two subproblems are identical, we restrict our analysis to the \
negative-\[Upsilon] domain. The solution in the positive-\[Upsilon] domain is \
determined by parity.\n\nWe then analyze the asymptotic behavior of the \
solutions at the two endpoints, \[Upsilon] = -1 and \[Upsilon] =0. This \
allows us to explicitly factor out the corresponding asymptotic behavior at \
each endpoint. We subsequently introduce a new radial coordinate s \[Element] \
[-1,1]. \n\nWe solve the coupled system numerically. Specifically, we match \
two numerical solutions propagated, respectively, from the two endpoints of \
the radial domain. We obtain the spectrum requiring the determinant of the \
matching matrix, constructed from the numerical solutions and their \
derivatives, to vanish at a specified point in the interior of the \
integration domain. This determinant constitutes a generalization of the \
Wronskian to the coupled system."
}], "Text",
 CellChangeTimes->{{3.998536408800581*^9, 3.9985365204644623`*^9}, {
  4.003975054182783*^9, 4.003975082736882*^9}, {4.003975250282073*^9, 
  4.003975251706565*^9}},ExpressionUUID->"e96745a1-c483-454c-b8d8-\
b3ffdf51b7cc"],

Cell[TextData[{
 StyleBox["Notation:",
  FontWeight->"Bold"],
 "\n- For ease of notation, the fields ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Eta]", "1"], TraditionalForm]],ExpressionUUID->
  "32547a6a-4d48-334c-80b9-47dc449141d8"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Eta]", "2"], TraditionalForm]],ExpressionUUID->
  "34725b54-c8f7-7e42-9171-69faf1e69a0a"],
 " in the paper are here denoted with ",
 Cell[BoxData[
  FormBox["\[Chi]", TraditionalForm]],ExpressionUUID->
  "f04b057c-50d8-524d-9a57-f7d4406bba0b"],
 " and ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]],ExpressionUUID->
  "f84e2a46-676b-0b4b-910f-b152c51ac07a"],
 ", respectively."
}], "Text",
 CellChangeTimes->{{3.986461080516285*^9, 3.9864611674664707`*^9}, {
  3.998536326266245*^9, 
  3.99853633487717*^9}},ExpressionUUID->"b0993894-11c4-4549-9b9d-\
802a20f3c1a0"],

