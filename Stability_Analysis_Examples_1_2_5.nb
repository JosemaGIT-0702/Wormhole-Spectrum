Cell["Discretized problem:", "Text",
 CellChangeTimes->{{3.986457496246193*^9, 
  3.986457500948992*^9}},ExpressionUUID->"f1488006-9b69-0f41-a96b-\
363da2b51b13"],

Cell[BoxData[
 RowBox[{
  RowBox[{"buildMatrices", "[", "NN_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", "S0v", ",", "A0v", ",", "A1v", ",", "B0v", ",", "B1v", ",", 
      "M0", ",", "M1", ",", "n1"}], "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{
     "Work", " ", "with", " ", "packed", " ", "interior", " ", "grid"}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n1", "=", 
      RowBox[{"NN", "+", "1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"s", "=", 
      RowBox[{"Developer`ToPackedArray", "[", 
       RowBox[{"chebGrid", "[", "NN", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Vectorized", " ", "evaluation", " ", 
       RowBox[{"(", 
        RowBox[{"no", " ", 
         RowBox[{"Table", "!"}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"S0v", "=", 
      RowBox[{"Developer`ToPackedArray", "[", 
       RowBox[{"S0", "/@", "s"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"A0v", "=", 
      RowBox[{"Developer`ToPackedArray", "[", 
       RowBox[{"A0", "/@", "s"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"A1v", "=", 
      RowBox[{"Developer`ToPackedArray", "[", 
       RowBox[{"A1", "/@", "s"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"B0v", "=", 
      RowBox[{"Developer`ToPackedArray", "[", 
       RowBox[{"B0", "/@", "s"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"B1v", "=", 
      RowBox[{"Developer`ToPackedArray", "[", 
       RowBox[{"B1", "/@", "s"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Replace", " ", 
       RowBox[{
        RowBox[{"DiagonalMatrix", "[", "v", "]"}], ".", "D"}], " ", "with", " ",
        "fast", " ", "row", " ", "scaling"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"D1", "=", 
      RowBox[{"chebD", "[", 
       RowBox[{"NN", ",", "100"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"D2", "=", 
      RowBox[{"D1", ".", "D1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"M0", "=", 
      RowBox[{
       RowBox[{"S0v", "*", "D2"}], "+", 
       RowBox[{"A0v", "*", "D1"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"M0", "=", 
      RowBox[{"M0", "+", 
       RowBox[{"DiagonalMatrix", "[", "B0v", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"M1", "=", 
      RowBox[{
       RowBox[{"A1v", "*", "D1"}], "+", 
       RowBox[{"DiagonalMatrix", "[", "B1v", "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"M0", ",", "M1"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9864576297269726`*^9, 3.9864576337119865`*^9}, {
  3.9864577045225067`*^9, 3.986457707602625*^9}, {3.9864578758356247`*^9, 
  3.9864578843896313`*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"c68ea26c-42e4-f141-a8ec-6c1e91637c45"],

