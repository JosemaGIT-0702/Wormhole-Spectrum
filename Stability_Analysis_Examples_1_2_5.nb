    StyleBox["M", "TI"], "2"], TraditionalForm]],ExpressionUUID->
  "a466697e-715a-bb45-b0d9-aa900961a46b"],
 " of the paper is denoted in the present notebook with ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]],ExpressionUUID->
  "bb3bcecf-d5bc-a240-853b-e1a0f1116152"],
 "."
}], "Text",
