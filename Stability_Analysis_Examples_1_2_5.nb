Cell[BoxData[
 InterpretationBox[
  RowBox[{
   FractionBox[
    RowBox[{
     SqrtBox[
      RowBox[{"2", "+", "\[Lambda]", "-", 
       RowBox[{
        SqrtBox["\[Lambda]"], " ", 
        SqrtBox[
         RowBox[{"4", "+", "\[Lambda]"}]]}]}]], " ", 
     SqrtBox[
      RowBox[{"2", "+", "\[Lambda]", "+", 
       RowBox[{
        SqrtBox["\[Lambda]"], " ", 
        SqrtBox[
         RowBox[{"4", "+", "\[Lambda]"}]]}]}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"8", " ", 
        SqrtBox[
         RowBox[{"4", "+", "\[Lambda]"}]], " ", 
        RowBox[{"Abs", "[", "\[Lambda]", "]"}], " ", 
        TemplateBox[{"1"},
         "C"]}], "+", 
       RowBox[{"\[ImaginaryI]", " ", 
        TemplateBox[{"2"},
         "C"]}]}], ")"}]}], 
    RowBox[{"8", " ", 
     SqrtBox[
      RowBox[{"4", "+", "\[Lambda]"}]], " ", 
     RowBox[{"Abs", "[", "\[Lambda]", "]"}], " ", "v"}]], "+", 
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "2"}], "+", "\[Lambda]"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"8", " ", 
        SqrtBox[
         RowBox[{"4", "+", "\[Lambda]"}]], " ", 
        RowBox[{"Abs", "[", "\[Lambda]", "]"}], " ", 
        TemplateBox[{"1"},
         "C"]}], "+", 
       RowBox[{"\[ImaginaryI]", " ", 
        TemplateBox[{"2"},
         "C"]}]}], ")"}], " ", "v"}], 
    RowBox[{"4", " ", 
     SqrtBox[
      RowBox[{"4", "+", "\[Lambda]"}]], " ", 
     SqrtBox[
      RowBox[{"2", "+", "\[Lambda]", "-", 
       RowBox[{
        SqrtBox["\[Lambda]"], " ", 
        SqrtBox[
         RowBox[{"4", "+", "\[Lambda]"}]]}]}]], " ", 
     SqrtBox[
      RowBox[{"2", "+", "\[Lambda]", "+", 
       RowBox[{
        SqrtBox["\[Lambda]"], " ", 
        SqrtBox[
         RowBox[{"4", "+", "\[Lambda]"}]]}]}]], " ", 
     RowBox[{"Abs", "[", "\[Lambda]", "]"}]}]], "+", 
   FractionBox[
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"32", " ", "\[ImaginaryI]", " ", 
        SuperscriptBox["\[Lambda]", "2"], " ", 
        SqrtBox[
         RowBox[{"4", "+", "\[Lambda]"}]], " ", 
        RowBox[{"Abs", "[", "\[Lambda]", "]"}], " ", 
        TemplateBox[{"1"},
         "C"]}], "+", 
       RowBox[{"8", " ", "\[ImaginaryI]", " ", 
        SuperscriptBox["\[Lambda]", "3"], " ", 
        SqrtBox[
         RowBox[{"4", "+", "\[Lambda]"}]], " ", 
        RowBox[{"Abs", "[", "\[Lambda]", "]"}], " ", 
        TemplateBox[{"1"},
         "C"]}], "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["\[Lambda]", "2"], " ", 
        TemplateBox[{"2"},
         "C"]}], "+", 
       RowBox[{
        SuperscriptBox["\[Lambda]", "3"], " ", 
        TemplateBox[{"2"},
         "C"]}]}], ")"}], " ", 
     SuperscriptBox["v", "2"]}], 
    RowBox[{"3", " ", 
     SqrtBox[
      RowBox[{"4", "+", "\[Lambda]"}]], " ", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["\[Lambda]", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"4", "+", "\[Lambda]"}], ")"}]}]], " ", 
