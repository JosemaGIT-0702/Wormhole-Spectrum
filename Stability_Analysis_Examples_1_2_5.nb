    RowBox[{"-", "1"}], "-", 
    RowBox[{"5", " ", 
     SuperscriptBox["v", "2"]}], "+", 
    RowBox[{"5", " ", 
     SuperscriptBox["v", "4"]}], "+", 
    SuperscriptBox["v", "6"]}]], "+", 
  RowBox[{
   SuperscriptBox["z\[Eta]", "\[Prime]\[Prime]",
    MultilineFunction->None], "[", "v", "]"}]}]], "Output",
 CellChangeTimes->{
