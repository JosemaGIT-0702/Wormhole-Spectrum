Cell[TextData[{
 "Equation of motion. We define the dimensionless eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "\[Congruent]", 
    RowBox[{"L", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["\[Omega]", "2"], "-", 
       SuperscriptBox[
        StyleBox["k", "TI"], "2"]}]]}]}], TraditionalForm]],ExpressionUUID->
  "86eeff71-77a1-7342-b3dc-fe21e30d7b22"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9864331594238567`*^9, 3.986433162883564*^9}, {
   3.9864333539973354`*^9, 3.98643336370566*^9}, {3.986433395007128*^9, 
   3.986433417729538*^9}, {3.9864361095648003`*^9, 3.986436115843605*^9}, 
   3.986458651533945*^9},ExpressionUUID->"01ba7c6b-c352-d149-9e78-\
a5635839f4af"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"eqZ\[Eta]", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["Z\[Eta]", "\[Prime]\[Prime]",
        MultilineFunction->None], "[", "r", "]"}], "+", 
      RowBox[{
       FractionBox[
        RowBox[{"3", " ", 
         RowBox[{
          SuperscriptBox["a", "\[Prime]",
           MultilineFunction->None], "[", "r", "]"}], " "}], 
        RowBox[{"2", 
         RowBox[{"a", "[", "r", "]"}]}]], 
       RowBox[{
        SuperscriptBox["Z\[Eta]", "\[Prime]",
         MultilineFunction->None], "[", "r", "]"}]}], "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{
           SuperscriptBox["w", "2"], "-", 
           SuperscriptBox["k", "2"]}], 
          RowBox[{"a", "[", "r", "]"}]], "-", 
         FractionBox[
          RowBox[{"2", " ", 
           RowBox[{"a", "[", "r", "]"}], " ", 
           RowBox[{
            SuperscriptBox["V", "\[Prime]",
             MultilineFunction->None], "[", 
            RowBox[{"\[Eta]0", "[", "r", "]"}], "]"}], " ", 
           RowBox[{
            SuperscriptBox["\[Eta]0", "\[Prime]",
             MultilineFunction->None], "[", "r", "]"}]}], 
          RowBox[{
           SuperscriptBox["a", "\[Prime]",
            MultilineFunction->None], "[", "r", "]"}]], "-", 
         RowBox[{
          FractionBox["3", "2"], " ", 
          SuperscriptBox[
           RowBox[{
            SuperscriptBox["\[Eta]0", "\[Prime]",
             MultilineFunction->None], "[", "r", "]"}], "2"]}], "-", 
         FractionBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"a", "[", "r", "]"}], "2"], " ", 
           SuperscriptBox[
            RowBox[{
             SuperscriptBox["\[Eta]0", "\[Prime]",
              MultilineFunction->None], "[", "r", "]"}], "4"]}], 
          RowBox[{"2", 
           SuperscriptBox[
            RowBox[{
             SuperscriptBox["a", "\[Prime]",
              MultilineFunction->None], "[", "r", "]"}], "2"]}]], "+", 
         RowBox[{
          SuperscriptBox["V", "\[Prime]\[Prime]",
           MultilineFunction->None], "[", 
          RowBox[{"\[Eta]0", "[", "r", "]"}], "]"}]}], ")"}], 
       RowBox[{"Z\[Eta]", "[", "r", "]"}]}]}], "/.", 
     RowBox[{"w", "->", 
      FractionBox[
       SqrtBox[
        RowBox[{"\[Lambda]", "+", 
         RowBox[{
          SuperscriptBox["L", "2"], 
          SuperscriptBox["k", "2"]}]}]], "L"]}]}], "//", "TrigToExp"}], "//", 
   "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.9864323079299564`*^9, 3.986432309840212*^9}, {
   3.986432353437895*^9, 3.9864324339396553`*^9}, {3.9864327582963543`*^9, 
   3.9864327758728504`*^9}, 3.986433172846611*^9, {3.9864332132761*^9, 
   3.9864332154930153`*^9}, {3.9864332738711834`*^9, 
   3.9864332884302254`*^9}, {3.9864334271982136`*^9, 3.986433447230854*^9}, {
   3.9864361420930443`*^9, 3.986436142941536*^9}, {3.986458565188303*^9, 
   3.986458577514189*^9}, {3.986458612043461*^9, 3.9864586286629944`*^9}, 
   3.9864587551140995`*^9},
 CellLabel->"In[6]:=",ExpressionUUID->"4913a222-712d-6040-b76d-823099dd1bc5"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", 
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{"8", " ", "r"}], "L"]]}], "+", 
      RowBox[{"2", " ", 
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{"8", " ", "r0"}], "L"]]}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"3", " ", "r"}], "+", "r0"}], ")"}]}], "L"]], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "8"}], "+", "\[Lambda]"}], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{"r", "+", 
            RowBox[{"3", " ", "r0"}]}], ")"}]}], "L"]], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "8"}], "+", "\[Lambda]"}], ")"}]}], "-", 
      RowBox[{"2", " ", 
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{"4", " ", 
          RowBox[{"(", 
           RowBox[{"r", "+", "r0"}], ")"}]}], "L"]], " ", 
       RowBox[{"(", 
        RowBox[{"10", "+", "\[Lambda]"}], ")"}]}]}], ")"}], " ", 
    RowBox[{"Z\[Eta]", "[", "r", "]"}]}], 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{"4", " ", "r"}], "L"]], "-", 
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{"4", " ", "r0"}], "L"]]}], ")"}], "2"], " ", 
    SuperscriptBox["L", "2"]}]], "+", 
  FractionBox[
   RowBox[{"3", " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       FractionBox[
        RowBox[{"2", " ", "r"}], "L"]], "-", 
      SuperscriptBox["\[ExponentialE]", 
       FractionBox[
        RowBox[{"2", " ", "r0"}], "L"]]}], ")"}], " ", 
    RowBox[{
     SuperscriptBox["Z\[Eta]", "\[Prime]",
      MultilineFunction->None], "[", "r", "]"}]}], 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       FractionBox[
        RowBox[{"2", " ", "r"}], "L"]], "+", 
      SuperscriptBox["\[ExponentialE]", 
       FractionBox[
        RowBox[{"2", " ", "r0"}], "L"]]}], ")"}], " ", "L"}]], "+", 
  RowBox[{
   SuperscriptBox["Z\[Eta]", "\[Prime]\[Prime]",
    MultilineFunction->None], "[", "r", "]"}]}]], "Output",
 CellChangeTimes->{
  3.986433173321516*^9, {3.986433205612715*^9, 3.98643321927194*^9}, {
   3.986433279377327*^9, 3.9864332895950565`*^9}, 3.9864334480951557`*^9, {
