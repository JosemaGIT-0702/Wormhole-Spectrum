Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rv", "[", "v_", "]"}], "=", 
    RowBox[{
     FractionBox["L", "2"], " ", 
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{"1", "+", "v"}], 
       RowBox[{"1", "-", "v"}]], "]"}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "old", " ", "coordinate", " ", "as", " ", "a", " ", "function", " ", "of", 
    " ", "the", " ", "new", " ", "coordinate"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"vr", "[", "rr_", "]"}], "=", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"2", 
          FractionBox["rr", "L"]}]], "\[Equal]", 
        FractionBox[
         RowBox[{"1", "+", "v"}], 
         RowBox[{"1", "-", "v"}]]}], ",", "v"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
