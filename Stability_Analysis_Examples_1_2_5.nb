Cell[BoxData[{
 RowBox[{
  RowBox[{"eq\[Psi]\[Chi]", "=", 
   RowBox[{"Assuming", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "1"}], "<", "s", "<", "1"}], ",", 
     RowBox[{"Collect", "[", 
      RowBox[{
       FractionBox[
        RowBox[{"eqz\[Chi]", "/.", 
         RowBox[{"v", "->", 
          RowBox[{"vs", "[", "s", "]"}]}]}], 
        RowBox[{"Coefficient", "[", 
         RowBox[{
          RowBox[{"eqz\[Chi]", "/.", 
           RowBox[{"v", "->", 
            RowBox[{"vs", "[", "s", "]"}]}]}], ",", 
          RowBox[{
           SuperscriptBox["\[Psi]\[Chi]", "\[Prime]\[Prime]",
            MultilineFunction->None], "[", "s", "]"}]}], "]"}]], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SuperscriptBox["\[Psi]\[Chi]", "\[Prime]\[Prime]",
           MultilineFunction->None], "[", "s", "]"}], ",", 
         RowBox[{
          SuperscriptBox["\[Psi]\[Chi]", "\[Prime]",
           MultilineFunction->None], "[", "s", "]"}], ",", 
         RowBox[{"\[Psi]\[Chi]", "[", "s", "]"}], ",", 
         RowBox[{"\[Psi]\[Alpha]", "[", "s", "]"}], ",", "\[Lambda]"}], "}"}],
        ",", "Simplify"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eq\[Psi]\[Alpha]", "=", 
   RowBox[{"Assuming", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "1"}], "<", "s", "<", "1"}], ",", 
     RowBox[{"Collect", "[", 
      RowBox[{
       FractionBox[
        RowBox[{"eqz\[Alpha]", "/.", 
         RowBox[{"v", "->", 
          RowBox[{"vs", "[", "s", "]"}]}]}], 
        RowBox[{"Coefficient", "[", 
         RowBox[{
          RowBox[{"eqz\[Alpha]", "/.", 
           RowBox[{"v", "->", 
            RowBox[{"vs", "[", "s", "]"}]}]}], ",", 
          RowBox[{
           SuperscriptBox["\[Psi]\[Alpha]", "\[Prime]\[Prime]",
            MultilineFunction->None], "[", "s", "]"}]}], "]"}]], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SuperscriptBox["\[Psi]\[Alpha]", "\[Prime]\[Prime]",
           MultilineFunction->None], "[", "s", "]"}], ",", 
