Cell[BoxData[
 RowBox[{"eqZ\[Eta]", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["Z\[Eta]", "\[Prime]\[Prime]",
        MultilineFunction->None], "[", "r", "]"}], "+", 
      RowBox[{
       FractionBox[
        RowBox[{"3", " ", 
         RowBox[{
          SuperscriptBox["a", "\[Prime]",
           MultilineFunction->None], "[", "r", "]"}], " "}], 
        RowBox[{"2", 
         RowBox[{"a", "[", "r", "]"}]}]], 
       RowBox[{
        SuperscriptBox["Z\[Eta]", "\[Prime]",
         MultilineFunction->None], "[", "r", "]"}]}], "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{
           SuperscriptBox["w", "2"], "-", 
           SuperscriptBox["k", "2"]}], 
          RowBox[{"a", "[", "r", "]"}]], "-", 
         FractionBox[
          RowBox[{"2", " ", 
           RowBox[{"a", "[", "r", "]"}], " ", 
           RowBox[{
            SuperscriptBox["V", "\[Prime]",
             MultilineFunction->None], "[", 
            RowBox[{"\[Eta]0", "[", "r", "]"}], "]"}], " ", 
           RowBox[{
            SuperscriptBox["\[Eta]0", "\[Prime]",
             MultilineFunction->None], "[", "r", "]"}]}], 
          RowBox[{
           SuperscriptBox["a", "\[Prime]",
            MultilineFunction->None], "[", "r", "]"}]], "-", 
         RowBox[{
          FractionBox["3", "2"], " ", 
          SuperscriptBox[
           RowBox[{
            SuperscriptBox["\[Eta]0", "\[Prime]",
             MultilineFunction->None], "[", "r", "]"}], "2"]}], "-", 
         FractionBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"a", "[", "r", "]"}], "2"], " ", 
           SuperscriptBox[
            RowBox[{
             SuperscriptBox["\[Eta]0", "\[Prime]",
              MultilineFunction->None], "[", "r", "]"}], "4"]}], 
          RowBox[{"2", 
           SuperscriptBox[
            RowBox[{
             SuperscriptBox["a", "\[Prime]",
              MultilineFunction->None], "[", "r", "]"}], "2"]}]], "+", 
         RowBox[{
          SuperscriptBox["V", "\[Prime]\[Prime]",
           MultilineFunction->None], "[", 
          RowBox[{"\[Eta]0", "[", "r", "]"}], "]"}]}], ")"}], 
       RowBox[{"Z\[Eta]", "[", "r", "]"}]}]}], "/.", 
     RowBox[{"w", "->", 
      FractionBox[
       SqrtBox[
        RowBox[{"\[Lambda]", "+", 
         RowBox[{
          SuperscriptBox["L", "2"], 
          SuperscriptBox["k", "2"]}]}]], "L"]}]}], "//", "TrigToExp"}], "//", 
   "Simplify"}]}]], "Input",
