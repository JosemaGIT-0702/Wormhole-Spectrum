Cell["Gauss-Lobatto grid:", "Text",
 CellChangeTimes->{{3.9864574273879128`*^9, 
  3.9864574321412163`*^9}},ExpressionUUID->"a20c667d-ac42-4858-bfc9-\
7bc171d942a7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"chebGrid", "[", "n_", "]"}], ":=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"Pi", " ", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "n"}], "]"}], "/", "n"}]}], "]"}], ",", "100"}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9864577128224964`*^9, 3.986457713150593*^9}},
 CellLabel->"In[64]:=",ExpressionUUID->"8bf6511b-fa60-4692-8f60-7fdd438e0506"],

Cell[" ", "Text",
 Editable->False,
 Selectable->False,
 CellFrame->{{0, 0}, {0, 0.5}},
 ShowCellBracket->False,
 CellMargins->{{0, 0}, {1, 1}},
 CellElementSpacings->{"CellMinHeight"->1},
 CellFrameMargins->0,
 CellFrameColor->RGBColor[0, 0, 1],
 CellSize->{
  Inherited, 3},ExpressionUUID->"4f4b43dc-5772-46ea-8703-33f59de386f9"],

Cell["Matrices for first and second derivative:", "Text",
 CellChangeTimes->{{3.9864574506854877`*^9, 
  3.986457489459242*^9}},ExpressionUUID->"50d6de5a-5422-41f2-b16a-\
00b455de81d4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"chebD", "[", 
   RowBox[{"n_", ",", 
    RowBox[{"prec_", ":", " ", "MachinePrecision"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "c", ",", "D", ",", "X", ",", "C", ",", "dX"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x", "=", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"Pi", " ", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", "n"}], "]"}], "/", "n"}]}], "]"}], ",", 
        "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "2", "}"}], ",", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"1", ",", 
           RowBox[{"n", "-", "1"}]}], "]"}], ",", 
         RowBox[{"{", "2", "}"}]}], "]"}], "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "^", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "n"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Build", " ", "matrices"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"X", "=", 
      RowBox[{"Outer", "[", 
       RowBox[{"Subtract", ",", "x", ",", "x"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"C", "=", 
      RowBox[{"Outer", "[", 
       RowBox[{"Times", ",", "c", ",", 
        RowBox[{"1", "/", "c"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Add", " ", "identity", " ", "to", " ", "avoid", " ", "division", " ", 
       "by", " ", "zero"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dX", "=", 
      RowBox[{"X", "+", 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"n", "+", "1"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"D", "=", 
      RowBox[{"C", "/", "dX"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Fix", " ", "diagonal"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"D", "=", 
      RowBox[{"D", "-", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Total", "[", 
         RowBox[{"D", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "D"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.986457860949415*^9, 3.9864578637508965`*^9}},
 CellLabel->"In[65]:=",ExpressionUUID->"94bfe8a1-6604-4b83-8b66-5b99566fc9d7"],

