  RowBox[{
   RowBox[{"\[Eta]0", "[", "r_", "]"}], "=", 
   RowBox[{"4", 
    RowBox[{"ArcTan", "[", 
     SuperscriptBox["\[ExponentialE]", 
      FractionBox[
       RowBox[{"r", "-", "r0"}], "L"]], "]"}]}]}], ";"}]], "Input",
