Cell["\<\
We factor out explicitly the normalizable behaviours at both asymptotic \
regions and fix the even or odd parity:\
\>", "Text",
 CellChangeTimes->{{3.986435089089012*^9, 3.986435089401499*^9}, {
  3.9864351333922653`*^9, 3.986435159558197*^9}, {3.9864352320378017`*^9, 
  3.9864352401313915`*^9}, {4.0039734602021947`*^9, 
  4.0039734827528644`*^9}},ExpressionUUID->"5b648645-a1a9-7149-84f0-\
e8bd49ab3574"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqz\[Eta]e", "=", 
   RowBox[{"eqz\[Eta]", "/.", 
    RowBox[{"z\[Eta]", "\[Rule]", "z\[Eta]e"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqz\[Eta]o", "=", 
   RowBox[{"eqz\[Eta]", "/.", 
    RowBox[{"z\[Eta]", "\[Rule]", "z\[Eta]o"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.003973706579257*^9, 4.0039737323321533`*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"0b27c200-0806-4ca4-8c03-f2368108d568"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"z\[Eta]e", "[", "v_", "]"}], "=", 
   RowBox[{
    SuperscriptBox["v", "2"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["v", "2"]}], ")"}], "2"], 
    RowBox[{"\[Psi]ve", "[", "v", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"z\[Eta]o", "[", "v_", "]"}], "=", 
   RowBox[{
    RowBox[{"1", "/", "v"}], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["v", "2"]}], ")"}], "2"], 
    RowBox[{"\[Psi]vo", "[", "v", "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.986435093909788*^9, 3.986435130438383*^9}, {
  3.986435173584835*^9, 3.9864351776228867`*^9}, {4.003973425393942*^9, 
  4.0039734572635026`*^9}, {4.0039735375315447`*^9, 4.0039735392233768`*^9}, {
  4.0039736684900017`*^9, 4.0039736697903204`*^9}, {4.0039737457965207`*^9, 
  4.0039737471047072`*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"d3e5004d-b9bb-d24c-b938-e2f7f6400ec6"],

Cell[TextData[{
 "We change the radial coordinate so that the domain coincides with the \
domain of Chebyshev polynomials ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[Element]", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "1"}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"af145a61-50c7-b043-941e-9d1ec4f4355b"],
 ". We also multiply the equation for the singular factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["s", "TI"], "2"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "b72bb9f9-c3d7-e449-9c5a-14b1e7fbe2a8"],
 ". We ensure that the parity of the solution is fixed."
}], "Text",
 CellChangeTimes->{{3.986435249790718*^9, 3.986435293481163*^9}, {
  3.986435582042473*^9, 3.98643562620129*^9}, {4.0039735087459774`*^9, 
  4.0039735273399153`*^9}},ExpressionUUID->"c7d96904-c59d-0649-8d71-\
ab3fb60580bf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"vs", "[", "s_", "]"}], "=", 
   RowBox[{"-", 
    RowBox[{"Sqrt", "[", 
     FractionBox[
      RowBox[{"1", "-", "s"}], "2"], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]ve", "[", "v_", "]"}], "=", 
   RowBox[{"\[Psi]e", "[", 
    RowBox[{"1", "-", 
     RowBox[{"2", 
      SuperscriptBox["v", "2"]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]vo", "[", "v_", "]"}], "=", 
   RowBox[{"\[Psi]o", "[", 
    RowBox[{"1", "-", 
     RowBox[{"2", 
      SuperscriptBox["v", "2"]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.986435307356598*^9, 3.986435396805334*^9}, {
  4.003973492322092*^9, 4.0039735061305037`*^9}, {4.003973542161686*^9, 
  4.0039735525236845`*^9}, {4.0039736577335777`*^9, 4.0039736644329996`*^9}, {
  4.0039737523810644`*^9, 4.003973755532406*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"91e60dff-501e-594a-bbca-a39b6d1a82be"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"eq\[Psi]e", "=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    FractionBox[
