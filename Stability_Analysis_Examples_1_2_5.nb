Cell["\<\
Analytical solution of eqz\[Eta] (found with Mathematica 11 but apparently \
not found by versions 13 and 14):\
\>", "Text",
 CellChangeTimes->{{3.986573787942692*^9, 
  3.986573836827734*^9}},ExpressionUUID->"2c19ae5d-27a7-de45-85ea-\
8aee05525d10"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"solz\[Eta]", "[", "v_", "]"}], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", 
      RowBox[{"8", " ", "v", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox["v", "2"]}], ")"}], " ", 
       SqrtBox[
        RowBox[{"4", "+", "\[Lambda]"}]], " ", 
       RowBox[{"Abs", "[", "\[Lambda]", "]"}]}]]}], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"\[ImaginaryI]", " ", "\[Lambda]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{"4", "+", "\[Lambda]"}], ")"}], " ", 
           RowBox[{"ArcTan", "[", "v", "]"}]}], "+", 
          RowBox[{
           SqrtBox["2"], " ", 
           RowBox[{"(", 
            RowBox[{
             FractionBox[
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "4"}], "-", "\[Lambda]", "+", 
                 RowBox[{
                  SqrtBox["\[Lambda]"], " ", 
                  SqrtBox[
                   RowBox[{"4", "+", "\[Lambda]"}]]}]}], ")"}], " ", 
               RowBox[{"ArcTan", "[", 
                FractionBox[
                 RowBox[{
                  SqrtBox["2"], " ", "v"}], 
                 SqrtBox[
                  RowBox[{"2", "+", "\[Lambda]", "-", 
                   RowBox[{
                    SqrtBox["\[Lambda]"], " ", 
                    SqrtBox[
                    RowBox[{"4", "+", "\[Lambda]"}]]}]}]]], "]"}]}], 
              SqrtBox[
               RowBox[{"2", "+", "\[Lambda]", "-", 
                RowBox[{
                 SqrtBox["\[Lambda]"], " ", 
                 SqrtBox[
                  RowBox[{"4", "+", "\[Lambda]"}]]}]}]]], "-", 
             FractionBox[
              RowBox[{
               RowBox[{"(", 
                RowBox[{"4", "+", "\[Lambda]", "+", 
                 RowBox[{
                  SqrtBox["\[Lambda]"], " ", 
                  SqrtBox[
                   RowBox[{"4", "+", "\[Lambda]"}]]}]}], ")"}], " ", 
               RowBox[{"ArcTan", "[", 
                FractionBox[
                 RowBox[{
                  SqrtBox["2"], " ", "v"}], 
                 SqrtBox[
                  RowBox[{"2", "+", "\[Lambda]", "+", 
                   RowBox[{
                    SqrtBox["\[Lambda]"], " ", 
                    SqrtBox[
                    RowBox[{"4", "+", "\[Lambda]"}]]}]}]]], "]"}]}], 
              SqrtBox[
               RowBox[{"2", "+", "\[Lambda]", "+", 
                RowBox[{
                 SqrtBox["\[Lambda]"], " ", 
                 SqrtBox[
                  RowBox[{"4", "+", "\[Lambda]"}]]}]}]]]}], ")"}]}]}], 
         ")"}]}], 
       RowBox[{"2", " ", 
        SqrtBox[
         RowBox[{
          SuperscriptBox["\[Lambda]", "2"], " ", 
          RowBox[{"(", 
           RowBox[{"4", "+", "\[Lambda]"}], ")"}]}]]}]]}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["v", "2"]}], ")"}], " ", 
    SqrtBox[
     RowBox[{"2", "+", 
      RowBox[{"2", " ", 
       SuperscriptBox["v", "2"]}], "+", "\[Lambda]", "-", 
      RowBox[{
       SqrtBox["\[Lambda]"], " ", 
       SqrtBox[
        RowBox[{"4", "+", "\[Lambda]"}]]}]}]], " ", 
    SqrtBox[
     RowBox[{"2", "+", 
      RowBox[{"2", " ", 
       SuperscriptBox["v", "2"]}], "+", "\[Lambda]", "+", 
      RowBox[{
       SqrtBox["\[Lambda]"], " ", 
       SqrtBox[
        RowBox[{"4", "+", "\[Lambda]"}]]}]}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"8", " ", 
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{"\[ImaginaryI]", " ", "\[Lambda]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", 
             RowBox[{"(", 
              RowBox[{"4", "+", "\[Lambda]"}], ")"}], " ", 
             RowBox[{"ArcTan", "[", "v", "]"}]}], "+", 
            RowBox[{
             SqrtBox["2"], " ", 
             RowBox[{"(", 
              RowBox[{
               FractionBox[
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "4"}], "-", "\[Lambda]", "+", 
                   RowBox[{
                    SqrtBox["\[Lambda]"], " ", 
                    SqrtBox[
                    RowBox[{"4", "+", "\[Lambda]"}]]}]}], ")"}], " ", 
                 RowBox[{"ArcTan", "[", 
                  FractionBox[
                   RowBox[{
                    SqrtBox["2"], " ", "v"}], 
                   SqrtBox[
                    RowBox[{"2", "+", "\[Lambda]", "-", 
                    RowBox[{
                    SqrtBox["\[Lambda]"], " ", 
                    SqrtBox[
                    RowBox[{"4", "+", "\[Lambda]"}]]}]}]]], "]"}]}], 
                SqrtBox[
                 RowBox[{"2", "+", "\[Lambda]", "-", 
                  RowBox[{
                   SqrtBox["\[Lambda]"], " ", 
                   SqrtBox[
                    RowBox[{"4", "+", "\[Lambda]"}]]}]}]]], "-", 
               FractionBox[
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"4", "+", "\[Lambda]", "+", 
                   RowBox[{
                    SqrtBox["\[Lambda]"], " ", 
                    SqrtBox[
                    RowBox[{"4", "+", "\[Lambda]"}]]}]}], ")"}], " ", 
                 RowBox[{"ArcTan", "[", 
                  FractionBox[
                   RowBox[{
                    SqrtBox["2"], " ", "v"}], 
                   SqrtBox[
                    RowBox[{"2", "+", "\[Lambda]", "+", 
                    RowBox[{
                    SqrtBox["\[Lambda]"], " ", 
                    SqrtBox[
                    RowBox[{"4", "+", "\[Lambda]"}]]}]}]]], "]"}]}], 
                SqrtBox[
                 RowBox[{"2", "+", "\[Lambda]", "+", 
                  RowBox[{
                   SqrtBox["\[Lambda]"], " ", 
                   SqrtBox[
                    RowBox[{"4", "+", "\[Lambda]"}]]}]}]]]}], ")"}]}]}], 
           ")"}]}], 
         SqrtBox[
          RowBox[{
           SuperscriptBox["\[Lambda]", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"4", "+", "\[Lambda]"}], ")"}]}]]]], " ", 
       SqrtBox[
        RowBox[{"4", "+", "\[Lambda]"}]], " ", 
       RowBox[{"Abs", "[", "\[Lambda]", "]"}], " ", 
       TemplateBox[{"1"},
        "C"]}], "+", 
      RowBox[{"\[ImaginaryI]", " ", 
       TemplateBox[{"2"},
        "C"]}]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.986552090080406*^9, 3.9865520917070103`*^9}, 
   3.986552141771675*^9},
 CellLabel->"In[11]:=",ExpressionUUID->"2bec10a0-8637-9943-bad6-adbccbcfe567"],

