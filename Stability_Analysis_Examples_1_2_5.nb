Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"chebGrid", "[", "n_", "]"}], ":=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"Pi", " ", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "n"}], "]"}], "/", "n"}]}], "]"}], ",", "100"}], 
    "]"}]}], ";"}]], "Input",
