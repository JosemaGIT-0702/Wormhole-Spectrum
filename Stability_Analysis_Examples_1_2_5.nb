Cell["\<\
We factor out explicitly the regular behaviours at both asymptotic regions:\
\>", "Text",
 CellChangeTimes->{{3.986435089089012*^9, 3.986435089401499*^9}, {
  3.9864351333922653`*^9, 3.986435159558197*^9}, {3.9864352320378017`*^9, 
  3.9864352401313915`*^9}},ExpressionUUID->"5b648645-a1a9-7149-84f0-\
e8bd49ab3574"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"z\[Eta]", "[", "v_", "]"}], "=", 
   RowBox[{
    SuperscriptBox["v", "2"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", "v"}], ")"}], "2"], 
    RowBox[{"\[Psi]v", "[", "v", "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.986435093909788*^9, 3.986435130438383*^9}, {
  3.986435173584835*^9, 3.9864351776228867`*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"d3e5004d-b9bb-d24c-b938-e2f7f6400ec6"],

Cell[TextData[{
 "We change the radial coordinate so that the domain coincides with the \
domain of Chebyshev polynomials ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[Element]", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "1"}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"af145a61-50c7-b043-941e-9d1ec4f4355b"],
 ". We also multiply the equation for the singular factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["s", "TI"], "2"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "b72bb9f9-c3d7-e449-9c5a-14b1e7fbe2a8"],
 "."
}], "Text",
 CellChangeTimes->{{3.986435249790718*^9, 3.986435293481163*^9}, {
  3.986435582042473*^9, 
  3.98643562620129*^9}},ExpressionUUID->"c7d96904-c59d-0649-8d71-\
ab3fb60580bf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"vs", "[", "s_", "]"}], "=", 
   FractionBox[
    RowBox[{"s", "-", "1"}], "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]v", "[", "v_", "]"}], "=", 
   RowBox[{"\[Psi]", "[", 
    RowBox[{
     RowBox[{"2", "v"}], "+", "1"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.986435307356598*^9, 3.986435396805334*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"91e60dff-501e-594a-bbca-a39b6d1a82be"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"eq\[Psi]", "=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "s"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"1", "+", "s"}], ")"}], "eqz\[Eta]"}], "/.", 
      RowBox[{"v", "->", 
       RowBox[{"vs", "[", "s", "]"}]}]}], 
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"eqz\[Eta]", "/.", 
        RowBox[{"v", "->", 
         RowBox[{"vs", "[", "s", "]"}]}]}], ",", 
       RowBox[{
        SuperscriptBox["\[Psi]", "\[Prime]\[Prime]",
         MultilineFunction->None], "[", "s", "]"}]}], "]"}]], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[Psi]", "\[Prime]\[Prime]",
        MultilineFunction->None], "[", "s", "]"}], ",", 
      RowBox[{
       SuperscriptBox["\[Psi]", "\[Prime]",
        MultilineFunction->None], "[", "s", "]"}], ",", 
      RowBox[{"\[Psi]", "[", "s", "]"}], ",", "\[Lambda]"}], "}"}], ",", 
    "FullSimplify"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.986435190044098*^9, 3.986435203404751*^9}, {
  3.9864354005412273`*^9, 3.986435461101753*^9}, {3.986435495829838*^9, 
  3.986435544527529*^9}, {3.9864356321704426`*^9, 3.986435638383545*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"7b8cac6c-8852-e047-946e-1664f5ab1292"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "18"}], "-", 
     FractionBox["32", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "3"}], "+", "s"}], ")"}], "2"]], "+", 
     FractionBox["28", 
      RowBox[{
       RowBox[{"-", "3"}], "+", "s"}]], "-", 
     FractionBox[
      RowBox[{"64", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "3"}], "+", "s"}], ")"}]}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"5", "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "2"}], "+", "s"}], ")"}], " ", "s"}]}], ")"}], "2"]],
      "-", 
     FractionBox["32", 
      RowBox[{"5", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "2"}], "+", "s"}], ")"}], " ", "s"}]}]], "-", 
     FractionBox[
      RowBox[{"32", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "41"}], "+", 
         RowBox[{"s", " ", 
          RowBox[{"(", 
           RowBox[{"39", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "15"}], "+", "s"}], ")"}], " ", "s"}]}], 
           ")"}]}]}], ")"}]}], 
      RowBox[{"41", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "2"}], "+", "s"}], ")"}], " ", "s", " ", 
        RowBox[{"(", 
         RowBox[{"26", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "2"}], "+", "s"}], ")"}], " ", "s"}]}], ")"}]}]}]], 
     "+", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{"8", "-", 
         RowBox[{"8", " ", 
          SuperscriptBox["s", "2"]}]}], ")"}], " ", "\[Lambda]"}], 
      RowBox[{"41", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "2"}], "+", "s"}], ")"}], " ", "s", " ", 
        RowBox[{"(", 
         RowBox[{"26", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "2"}], "+", "s"}], ")"}], " ", "s"}]}], 
         ")"}]}]}]]}], ")"}], " ", 
   RowBox[{"\[Psi]", "[", "s", "]"}]}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "2"}], "+", 
     FractionBox["24", 
      RowBox[{
       RowBox[{"-", "3"}], "+", "s"}]], "-", 
     RowBox[{"10", " ", "s"}], "+", 
     FractionBox[
      RowBox[{"32", " ", 
       RowBox[{"(", 
        RowBox[{"7", "+", "s", "+", 
         RowBox[{"3", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "s"}], ")"}], " ", 
          SuperscriptBox["s", "2"]}]}], ")"}]}], 
      RowBox[{"41", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "2"}], "+", "s"}], ")"}], " ", "s", " ", 
        RowBox[{"(", 
         RowBox[{"26", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "2"}], "+", "s"}], ")"}], " ", "s"}]}], 
         ")"}]}]}]]}], ")"}], " ", 
   RowBox[{
    SuperscriptBox["\[Psi]", "\[Prime]",
     MultilineFunction->None], "[", "s", "]"}]}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "-", 
     SuperscriptBox["s", "2"]}], ")"}], " ", 
   RowBox[{
    SuperscriptBox["\[Psi]", "\[Prime]\[Prime]",
     MultilineFunction->None], "[", "s", "]"}]}]}]], "Output",
 CellChangeTimes->{
  3.986435204318735*^9, 3.9864353280217896`*^9, {3.986435373013399*^9, 
   3.986435461585968*^9}, {3.986435508526617*^9, 3.9864355452955685`*^9}, 
   3.9864356391868744`*^9, 3.9864361598563766`*^9, 3.9864577891049747`*^9},
 CellLabel->"Out[22]=",ExpressionUUID->"1974ed5c-c5f0-9c4c-bd3e-bc0c998b801b"]
