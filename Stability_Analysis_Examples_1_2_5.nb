     SuperscriptBox["z\[Eta]", "\[Prime]",
      MultilineFunction->None], "[", "v", "]"}]}], 
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    SuperscriptBox["v", "4"]}]], "+", 
  RowBox[{
   SuperscriptBox["z\[Eta]", "\[Prime]\[Prime]",
    MultilineFunction->None], "[", "v", "]"}]}]], "Output",
 CellChangeTimes->{
  3.9864336186642857`*^9, {3.986433683504139*^9, 3.986433720718275*^9}, 
