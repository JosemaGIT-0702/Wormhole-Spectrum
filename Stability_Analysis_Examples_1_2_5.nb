Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rv", "[", "v_", "]"}], "=", 
    RowBox[{"r0", "+", 
     RowBox[{"L", " ", 
      RowBox[{"Log", "[", 
       FractionBox[
        RowBox[{"1", "+", "v"}], 
        RowBox[{"1", "-", "v"}]], "]"}]}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "old", " ", "coordinate", " ", "as", " ", "a", " ", "function", " ", "of", 
    " ", "the", " ", "new", " ", "coordinate"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"vr", "[", "rr_", "]"}], "=", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         FractionBox[
          RowBox[{"rr", "-", "r0"}], "L"]], "\[Equal]", 
        FractionBox[
         RowBox[{"1", "+", "v"}], 
         RowBox[{"1", "-", "v"}]]}], ",", "v"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "new", " ", "coordinate", " ", "as", " ", "a", " ", "function", " ", "of", 
    " ", "the", " ", "old", " ", "coordinate"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Z\[Eta]", "[", "r_", "]"}], "=", 
    RowBox[{"z\[Eta]", "[", 
     RowBox[{"vr", "[", "r", "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"eqz\[Eta]", "=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"4", 
         SuperscriptBox["L", "2"]}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["v", "2"], "-", "1"}], ")"}], "2"]], "eqZ\[Eta]"}], 
      "/.", 
      RowBox[{"r", "->", 
       RowBox[{"rv", "[", "v", "]"}]}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SuperscriptBox["z\[Eta]", "\[Prime]\[Prime]",
        MultilineFunction->None], "[", "v", "]"}], ",", 
      RowBox[{
       SuperscriptBox["z\[Eta]", "\[Prime]",
        MultilineFunction->None], "[", "v", "]"}], ",", 
      RowBox[{"z\[Eta]", "[", "v", "]"}], ",", "\[Lambda]"}], "}"}], ",", 
    "FullSimplify"}], "]"}]}]}], "Input",
