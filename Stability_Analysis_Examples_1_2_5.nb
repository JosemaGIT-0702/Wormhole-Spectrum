 CellChangeTimes->{{3.9864574273879128`*^9, 
  3.9864574321412163`*^9}},ExpressionUUID->"9222f569-5079-034b-8db0-\
b00fd96b5021"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"chebGrid", "[", "n_", "]"}], ":=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"Pi", " ", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "n"}], "]"}], "/", "n"}]}], "]"}], ",", "100"}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9864577128224964`*^9, 3.986457713150593*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"b511683e-fc51-804a-b87d-2d9d45034f55"],

