Cell[TextData[{
 "The equation is singular in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["v", "TI"], "\[LongEqual]", "0"}], TraditionalForm]],
  ExpressionUUID->"019ec9ee-2e09-2e47-bbe3-24fed9d82bd4"],
 ". The problem splits in two identical subproblems, negative ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["v", "TI"], "\[Element]", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "0"}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"7eebe738-9670-6846-9360-d1ce566cc38a"],
 " and positive ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["v", "TI"], "\[Element]", 
    RowBox[{"[", 
     RowBox[{"0", ",", "1"}], "]"}]}], TraditionalForm]],ExpressionUUID->
  "78143381-7f7f-ea4c-8c48-2646e598553d"],
 ". Let us consider the negative subproblem."
}], "Text",
 CellChangeTimes->{{3.9864343496162605`*^9, 
  3.986434455556322*^9}},ExpressionUUID->"376f6945-eb7c-4845-8619-\
3b5935b89167"],

