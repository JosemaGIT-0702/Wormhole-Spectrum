Cell[TextData[{
 "Modes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"~", " ", "1"}], "/", "v"}], TraditionalForm]],ExpressionUUID->
  "bab307e7-0a0c-4031-9aea-49d76cbd4988"],
 " are odd and modes ",
 Cell[BoxData[
  FormBox[
   RowBox[{"~", " ", 
    SuperscriptBox["v", "2"]}], TraditionalForm]],ExpressionUUID->
  "7db52446-5923-4ecc-b8d8-fb740359eb62"],
 " are even"
}], "Text",
 CellChangeTimes->{{3.986435089089012*^9, 3.986435089401499*^9}, {
  3.9864351333922653`*^9, 3.986435159558197*^9}, {3.9864352320378017`*^9, 
  3.9864352401313915`*^9}, {4.0039733023362513`*^9, 4.003973418714344*^9}, {
  4.00397368374603*^9, 
  4.0039736859453974`*^9}},ExpressionUUID->"c5ffe0b0-0c09-4966-baf5-\
aec519ebefe7"],

