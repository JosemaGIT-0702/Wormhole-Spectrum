Cell[BoxData[
 RowBox[{"sZ\[Phi]Worm", "=", 
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{"solz\[Eta]", "[", "v", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"v", ",", "0", ",", "2"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9857985632601943`*^9, 3.9857985981202393`*^9}, {
  3.9865738594139614`*^9, 3.9865738684558697`*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"e14fbdc8-06fa-134d-b6df-42319bd29640"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   FractionBox[
    RowBox[{
     SqrtBox[
      RowBox[{"2", "+", "\[Lambda]", "-", 
       RowBox[{
        SqrtBox["\[Lambda]"], " ", 
        SqrtBox[
         RowBox[{"4", "+", "\[Lambda]"}]]}]}]], " ", 
     SqrtBox[
      RowBox[{"2", "+", "\[Lambda]", "+", 
       RowBox[{
        SqrtBox["\[Lambda]"], " ", 
        SqrtBox[
         RowBox[{"4", "+", "\[Lambda]"}]]}]}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"8", " ", 
        SqrtBox[
         RowBox[{"4", "+", "\[Lambda]"}]], " ", 
        RowBox[{"Abs", "[", "\[Lambda]", "]"}], " ", 
        TemplateBox[{"1"},
         "C"]}], "+", 
       RowBox[{"\[ImaginaryI]", " ", 
        TemplateBox[{"2"},
         "C"]}]}], ")"}]}], 
    RowBox[{"8", " ", 
     SqrtBox[
      RowBox[{"4", "+", "\[Lambda]"}]], " ", 
     RowBox[{"Abs", "[", "\[Lambda]", "]"}], " ", "v"}]], "+", 
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "2"}], "+", "\[Lambda]"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"8", " ", 
        SqrtBox[
