Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"-", "2"}], "+", 
       RowBox[{"24", " ", 
        SuperscriptBox["v", "2"]}], "+", 
       RowBox[{"20", " ", 
        SuperscriptBox["v", "4"]}], "+", 
       RowBox[{"24", " ", 
        SuperscriptBox["v", "6"]}], "-", 
       RowBox[{"2", " ", 
        SuperscriptBox["v", "8"]}]}], 
      RowBox[{
       SuperscriptBox["v", "2"], " ", 
