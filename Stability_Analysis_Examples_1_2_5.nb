  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"S0", "[", "s_", "]"}], "=", 
   RowBox[{"Coefficient", "[", 
    RowBox[{"eq\[Psi]e", ",", 
     RowBox[{
      SuperscriptBox["\[Psi]e", "\[Prime]\[Prime]",
       MultilineFunction->None], "[", "s", "]"}]}], "]"}]}], 
