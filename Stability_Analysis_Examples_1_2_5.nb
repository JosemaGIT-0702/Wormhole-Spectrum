Cell["Change of radial coordinate (compactification):", "Text",
 CellChangeTimes->{{3.9864335024997826`*^9, 
  3.986433513095646*^9}},ExpressionUUID->"0377682c-4943-8f4c-92e3-\
5698e4de3587"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rv", "[", "v_", "]"}], "=", 
    RowBox[{"r0", "+", 
     RowBox[{"L", " ", 
      RowBox[{"Log", "[", 
       FractionBox[
        RowBox[{"1", "+", "v"}], 
        RowBox[{"1", "-", "v"}]], "]"}]}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "old", " ", "coordinate", " ", "as", " ", "a", " ", "function", " ", "of", 
    " ", "the", " ", "new", " ", "coordinate"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"vr", "[", "rr_", "]"}], "=", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         FractionBox[
          RowBox[{"rr", "-", "r0"}], "L"]], "\[Equal]", 
        FractionBox[
         RowBox[{"1", "+", "v"}], 
         RowBox[{"1", "-", "v"}]]}], ",", "v"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "new", " ", "coordinate", " ", "as", " ", "a", " ", "function", " ", "of", 
    " ", "the", " ", "old", " ", "coordinate"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Z\[Eta]", "[", "r_", "]"}], "=", 
    RowBox[{"z\[Eta]", "[", 
     RowBox[{"vr", "[", "r", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"eqz\[Eta]", "=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"4", 
         SuperscriptBox["L", "2"]}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["v", "2"], "-", "1"}], ")"}], "2"]], "eqZ\[Eta]"}], 
      "/.", 
      RowBox[{"r", "->", 
       RowBox[{"rv", "[", "v", "]"}]}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SuperscriptBox["z\[Eta]", "\[Prime]\[Prime]",
        MultilineFunction->None], "[", "v", "]"}], ",", 
      RowBox[{
       SuperscriptBox["z\[Eta]", "\[Prime]",
        MultilineFunction->None], "[", "v", "]"}], ",", 
      RowBox[{"z\[Eta]", "[", "v", "]"}], ",", "\[Lambda]"}], "}"}], ",", 
    "FullSimplify"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9864335433262825`*^9, 3.9864335682234936`*^9}, {
  3.9864336143684807`*^9, 3.9864337201822186`*^9}, {3.986433755059534*^9, 
  3.986433891405693*^9}, {3.986433936736929*^9, 3.986434082755745*^9}, {
  3.9864341264279556`*^9, 3.9864341795107136`*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"f82bf9a5-6572-9043-8417-7e96b632f1ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"6", " ", 
           SuperscriptBox["v", "2"]}], "+", 
          SuperscriptBox["v", "4"]}], ")"}]}], 
       RowBox[{
        SuperscriptBox["v", "2"], " ", 
