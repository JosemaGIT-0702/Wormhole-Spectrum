 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "\[Element]", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "1"}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"e01863e3-6912-364a-911b-7369b439fbb2"],
