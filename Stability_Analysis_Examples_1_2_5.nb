Cell[CellGroupData[{

Cell["Numerics, odd modes (shooting and Wronksian matching)", "Section",
 CellChangeTimes->{{3.9828334408029146`*^9, 3.9828334441804185`*^9}, {
   3.982837232137474*^9, 3.9828372333491344`*^9}, 3.986434253035969*^9, {
