   3.9864340830680923`*^9}, {3.9864341300414906`*^9, 3.986434180703045*^9}, 
   3.98643614580641*^9, 3.986457788355057*^9, 3.9864588179622173`*^9, 
   3.986531594974224*^9, 3.9865518826878414`*^9, 3.9865737490419636`*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"c2c4a000-bee2-7747-8c3c-a4f228b48a2b"]
