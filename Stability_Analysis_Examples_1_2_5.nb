 CellLabel->"In[4]:=",ExpressionUUID->"1290a55c-aad1-9c4b-bfe4-996a97056045"],

Cell[TextData[{
 "For convenience, we define the warp factor as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["a", "TI"], "(", 
     StyleBox["r", "TI"], ")"}], "\[Congruent]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"2", 
      RowBox[{
       StyleBox["A", "TI"], "(", 
       StyleBox["r", "TI"], ")"}]}]]}], TraditionalForm]],ExpressionUUID->
  "c405f705-3155-dc47-975d-11a9fc3875e8"],
 ", with"
}], "Text",
 CellChangeTimes->{{3.98643262805085*^9, 
  3.986432672654991*^9}},ExpressionUUID->"ed0e92d8-cc15-564b-a0da-\
a5a351b08140"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"a", "[", "r_", "]"}], "=", 
   RowBox[{"4", " ", 
    SuperscriptBox[
     RowBox[{"Cosh", "[", 
      FractionBox[
       RowBox[{"(", 
        RowBox[{"r", "-", "r0"}], ")"}], 
       RowBox[{" ", "L"}]], "]"}], "2"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9864327029873905`*^9, 3.9864327181916695`*^9}, {
  3.986433197160818*^9, 3.9864331972702103`*^9}, {3.986458502650141*^9, 
  3.9864585112422314`*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"abf60ed7-7884-ae48-a85a-cf9ad7a97bfc"]
}, Closed]],

