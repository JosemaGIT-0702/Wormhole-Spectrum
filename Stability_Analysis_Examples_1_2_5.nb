bfd92bd69628"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"d", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"V", "[", "\[Eta]_", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], 
     SuperscriptBox[
      RowBox[{
       RowBox[{"W", "'"}], "[", "\[Eta]", "]"}], "2"]}], "-", 
    RowBox[{
     FractionBox["d", 
      RowBox[{"4", 
       RowBox[{"(", 
        RowBox[{"d", "-", "1"}], ")"}]}]], 
     SuperscriptBox[
      RowBox[{"W", "[", "\[Eta]", "]"}], "2"]}]}], "//", 
   "Simplify"}]}]}], "Input",
