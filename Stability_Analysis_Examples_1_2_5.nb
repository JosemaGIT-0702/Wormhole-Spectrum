       SuperscriptBox["\[Psi]e", "\[Prime]",
        MultilineFunction->None], "[", "s", "]"}]}], "]"}], "/.", 
    RowBox[{"\[Lambda]", "->", "0"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
